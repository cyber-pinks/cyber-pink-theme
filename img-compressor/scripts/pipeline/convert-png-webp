import fs from "fs";
import path from "path";
import sharp from "sharp";

const INPUT_DIR = "images/screenshots";
const OUTPUT_DIR = "images/screenshots";

async function convertPngToWebp(file) {
  const inputPath = path.join(INPUT_DIR, file);
  const outputPath = path.join(
    OUTPUT_DIR,
    file.replace(".png", ".webp")
  );

  console.log(`Converting: ${inputPath} → ${outputPath}`);
  
  await sharp(inputPath)
    .resize(400) 
    .webp({ quality: 90 }) 
    .toFile(outputPath);

  console.log(`✔ Done: ${outputPath}`);
}

async function main() {
  if (!fs.existsSync(OUTPUT_DIR)) {
    fs.mkdirSync(OUTPUT_DIR, { recursive: true });
  }

  const files = fs.readdirSync(INPUT_DIR);
  const pngs = files.filter(f => f.endsWith(".png"));

  if (pngs.length === 0) {
    console.log("No png files found.");
    return;
  }

  for (const png of pngs) {
    await convertPngToWebp(png);
  }

  console.log("All pngs converted to WebP (Width: 400px).");
}

main();