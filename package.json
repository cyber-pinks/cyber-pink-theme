{
  "name": "cyber-pink-theme",
  "displayName": "Cyber Pink Color Theme",
  "description": "💗 Pink & 💙 Cyan / Cyberpunk / Neon glow / Dark mode color theme for VS Code — futuristic contrast and bold style.",
  "version": "0.4.3",
  "homepage": "https://cyber-pinks.github.io/cyber-pink-theme/",
  "publisher": "cyber-pinks",
  "author": {
    "name": "1abcdefggs",
    "url": "https://github.com/1abcdefggs"
  },
  "license": "MIT",
  "pricing": "Free",
  "repository": {
    "type": "git",
    "url": "https://github.com/cyber-pinks/cyber-pink-theme.git"
  },
  "bugs": {
  "url": "https://github.com/cyber-pinks/cyber-pink-theme/issues"
  },
  "keywords": [
    "dark",
    "cyberpunk",
    "neon",
    "pink",
    "cyan",
    "high-contrast",
    "aesthetic"
  ],
  "devDependencies": {
    "sharp": "^0.35.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#000000e6",
    "theme": "dark"
  },
  "categories": [
    "Themes"
  ],
  "main": "./extension.js",
  "scripts": {
  },
  "activationEvents": [
    "onStartupFinished",
    "onCommand:cyberPink.applyPinkNeon",
    "onCommand:cyberPink.applyPinkSoft",
    "onCommand:cyberPink.applyCyanNeon",
    "onCommand:cyberPink.applyCyanSoft",
    "onCommand:cyberPink.editThemeColorAtCursor",
    "onCommand:cyberPink.switchAccentPreset"
  ],
  "contributes": {
    "themes": [
      {
        "label": "CYBER PINK ▶ THEME — 💗 PINK NEON",
        "uiTheme": "vs-dark",
        "path": "./themes/cyber-pink-pink-neon.json",
        "description": "Pink Neon accent. Pure black base with cyberpunk glow. Keywords: cyber, pink, neon."
      },
      {
        "label": "CYBER PINK ▶ THEME — 🌸 PINK SOFT",
        "uiTheme": "vs-dark",
        "path": "./themes/cyber-pink-pink-soft.json",
        "description": "Pink Soft accent. Muted glow for extended sessions. Keywords: cyber, pink, soft."
      },
      {
        "label": "CYBER PINK ▶ THEME — 💙 CYAN NEON",
        "uiTheme": "vs-dark",
        "path": "./themes/cyber-pink-cyan-neon.json",
        "description": "Cyan Neon accent. Pure black base with cyberpunk glow. Keywords: cyber, cyan, neon."
      },
      {
        "label": "CYBER PINK ▶ THEME — 🫧 CYAN SOFT",
        "uiTheme": "vs-dark",
        "path": "./themes/cyber-pink-cyan-soft.json",
        "description": "Cyan Soft accent. Muted glow for extended sessions. Keywords: cyber, cyan, soft."
      }
    ],
    "commands": [
      {
        "command": "cyberPink.applyPinkNeon",
        "title": "▶ THEME — 💗 PINK NEON SET",
        "category": "CYBER PINK"
      },
      {
        "command": "cyberPink.applyPinkSoft",
        "title": "▶ THEME — 🌸 PINK SOFT SET",
        "category": "CYBER PINK"
      },
      {
        "command": "cyberPink.applyCyanNeon",
        "title": "▶ THEME — 💙 CYAN NEON SET",
        "category": "CYBER PINK"
      },
      {
        "command": "cyberPink.applyCyanSoft",
        "title": "▶ THEME — 🫧 CYAN SOFT SET",
        "category": "CYBER PINK"
      },
      {
        "command": "cyberPink.switchAccentPreset",
        "title": "▶ THEME — SWITCH ACCENT PRESET (THEME)",
        "category": "CYBER PINK"
      },
      {
        "command": "cyberPink.editThemeColorAtCursor",
        "title": "▶ EDITOR — EDIT THEME COLOR AT CURSOR",
        "category": "CYBER PINK"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "cyberPink.applyPinkNeon",
          "when": "true",
          "group": "1a_pink_neon"
        },
        {
          "command": "cyberPink.applyPinkSoft",
          "when": "true",
          "group": "1b_pink_soft"
        },
        {
          "command": "cyberPink.applyCyanNeon",
          "when": "true",
          "group": "2a_cyan_neon"
        },
        {
          "command": "cyberPink.applyCyanSoft",
          "when": "true",
          "group": "2b_cyan_soft"
        },
        {
          "command": "cyberPink.switchAccentPreset",
          "when": "true",
          "group": "3_accent"
        },
        {
          "command": "cyberPink.editThemeColorAtCursor",
          "when": "true",
          "group": "4_editor"
        }
      ],
      "editor/context": [
        {
          "command": "cyberPink.editThemeColorAtCursor",
          "when": "editorTextFocus && !editorReadonly",
          "group": "navigation"
        },
        {
          "command": "cyberPink.switchAccentPreset",
          "when": "editorTextFocus && !editorReadonly",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Cyber Pink",
      "properties": {
        "cyberPink.background.base": {
          "type": "string",
          "default": "#000000",
          "description": "Base background color (editor, terminal)"
        },
        "cyberPink.background.deep": {
          "type": "string",
          "default": "#08090f",
          "description": "Deep background color (activity bar, title bar)"
        },
        "cyberPink.background.mid": {
          "type": "string",
          "default": "#0d0e17",
          "description": "Mid background color (sidebar, panels)"
        },
        "cyberPink.background.surface": {
          "type": "string",
          "default": "#111320",
          "description": "Surface background color (widgets, inputs)"
        },
        "cyberPink.accent.preset": {
          "type": "string",
          "enum": [
            "pinkNeon",
            "pinkSoft",
            "cyanNeon",
            "cyanSoft",
            "greenNeon",
            "amberNeon",
            "fuchsiaNeon",
            "blueNeon",
            "custom"
          ],
          "enumDescriptions": [
            "Pink Neon (#FF3399) - default",
            "Pink Soft (#D92B82)",
            "Cyan Neon (#00F0FF)",
            "Cyan Soft (#00CCD9)",
            "Green Neon (#5AFF19)",
            "Amber Neon (#FFC800)",
            "Fuchsia Neon (#CC1669)",
            "Blue Neon (#00AEEF)",
            "Use custom accent color"
          ],
          "default": "pinkNeon",
          "description": "Accent color preset for the theme"
        },
        "cyberPink.accent.customColor": {
          "type": "string",
          "default": "#FFFFFF",
          "description": "Custom accent color (default is white #FFFFFF for easy visibility when using the 'custom' preset)"
        },
        "cyberPink.accent.customHover": {
          "type": "string",
          "default": "#CCCCCC",
          "description": "Custom accent hover color (default is light gray #CCCCCC so beginners can clearly see the hover effect when using the 'custom' preset)"
        }
      }
    }
  }
}