{
  "name": "cyber-pink-theme",
  "displayName": "Cyber Pink Color Theme",
  "description": "💗 Pink & 💙 cyan / cyberpunk / neon glow / dark color theme for VS Code — futuristic contrast and bold style.",
  "version": "0.3.1",
  "publisher": "cyber-pinks",
  "license": "MIT",
  "keywords": ["theme","color theme","dark theme","cyber","cyber pink","cyberpunk","neon","pink","cyan","black"],
  "devDependencies": {
    "sharp": "^0.33.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cyber-pinks/cyber-pink-theme"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#C80000",
    "theme": "dark"
  },
  "categories": ["Themes"],
  "main": "./extension.js",
  "scripts": {
    "resize-images": "node scripts/resize-images.mjs",
    "resize-promo": "node img-compressor/scripts/pipeline/step5-resize-promo-images.mjs"
  },
  "activationEvents": [
    "onStartupFinished",
    "onCommand:cyberPink.editThemeColorAtCursor",
    "onCommand:cyberPink.switchAccentPreset"
  ],
  "contributes": {
    "themes": [
      {
        "label": "💗 CYBER PINK — Pink Neon",
        "uiTheme": "vs-dark",
        "path": "./themes/cyber-pink-pink-neon.json",
        "description": "Pink Neon accent. Pure black base with cyberpunk glow."
      },
      {
        "label": "🌸 CYBER PINK — Pink Soft",
        "uiTheme": "vs-dark",
        "path": "./themes/cyber-pink-pink-soft.json",
        "description": "Pink Soft accent. Muted glow for extended sessions."
      },
      {
        "label": "💙 CYBER PINK — Cyan Neon",
        "uiTheme": "vs-dark",
        "path": "./themes/cyber-pink-cyan-neon.json",
        "description": "Cyan Neon accent. Pure black base with cyberpunk glow."
      },
      {
        "label": "🫧 CYBER PINK — Cyan Soft",
        "uiTheme": "vs-dark",
        "path": "./themes/cyber-pink-cyan-soft.json",
        "description": "Cyan Soft accent. Muted glow for extended sessions."
      }
    ],
    "commands": [
      {
        "command": "cyberPink.editThemeColorAtCursor",
        "title": "Edit Theme Color at Cursor",
        "category": "Cyber Pink"
      },
      {
        "command": "cyberPink.switchAccentPreset",
        "title": "Switch Accent Preset",
        "category": "Cyber Pink"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "cyberPink.editThemeColorAtCursor",
          "group": "2_zcommand@5"
        }
      ]
    },
    "configuration": {
      "title": "Cyber Pink",
      "properties": {
        "cyberPink.background.base": {
          "type": "string",
          "default": "#000000",
          "description": "Base background color (editor, terminal)"
        },
        "cyberPink.background.deep": {
          "type": "string",
          "default": "#08090f",
          "description": "Deep background color (activity bar, title bar)"
        },
        "cyberPink.background.mid": {
          "type": "string",
          "default": "#0d0e17",
          "description": "Mid background color (sidebar, panels)"
        },
        "cyberPink.background.surface": {
          "type": "string",
          "default": "#111320",
          "description": "Surface background color (widgets, inputs)"
        },
              "cyberPink.accent.preset": {
          "type": "string",
          "enum": [
            "pinkNeon",
            "pinkSoft",
            "cyanNeon",
            "cyanSoft",
            "greenNeon",
            "amberNeon",
            "fuchsiaNeon",
            "blueNeon",
            "custom"
          ],
          "enumDescriptions": [
            "Pink Neon (#FF3399) - default",
            "Pink Soft (#D92B82)",
            "Cyan Neon (#00F0FF)",
            "Cyan Soft (#00CCD9)",
            "Green Neon (#5AFF19)",
            "Amber Neon (#FFC800)",
            "Fuchsia Neon (#CC1669)",
            "Blue Neon (#00AEEF)",
            "Use custom accent color"
          ],
          "default": "pinkNeon",
          "description": "Accent color preset for the theme"
        },
        "cyberPink.accent.customColor": {
          "type": "string",
          "default": "#FFFFFF",
          "description": "Custom accent color (default is white #FFFFFF for easy visibility when using the 'custom' preset)"
        },
        "cyberPink.accent.customHover": {
          "type": "string",
          "default": "#CCCCCC",
          "description": "Custom accent hover color (default is light gray #CCCCCC so beginners can clearly see the hover effect when using the 'custom' preset)"
        }
      }
    }
  }
}
